# Copy this file to ".env" and fill in your own Supabase project values.
# Supabase Dashboard → Project Settings → API (or "API Keys").
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Publishable key only (starts with sb_publishable_). NEVER put the secret key in the app.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: public web address that hosts the build, so the lost-pet QR opens a web page.
# Leave empty and the QR simply contains readable contact text (works in every scanner).
VITE_PUBLIC_WEB_URL=
